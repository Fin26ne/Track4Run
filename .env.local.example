# =====================================================================
# TRACK4RUN - BIẾN MÔI TRƯỜNG CẤU HÌNH (ENVIRONMENT VARIABLES)
# =====================================================================

# 1. Google Gemini API Key
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
# Lưu ý: Không có tiền tố NEXT_PUBLIC_ để chỉ chạy ở server Route Handlers
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Cloud Configuration
# Lấy tại Supabase Dashboard: Project Settings > API
# Lưu ý: Có tiền tố NEXT_PUBLIC_ để Client Components kết nối trực tiếp với Supabase.
# Bảo mật được bảo vệ 100% qua chính sách Row Level Security (RLS) của Postgres.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
